FROM jlesage/baseimage-gui:ubuntu-24.04-v4
# ubuntu-22.04-v4

ENV WINEPREFIX=/config/wine/
ENV LANG=en_US.UTF-8
ENV APP_NAME="Backblaze Personal Backup"
ENV FORCE_LATEST_UPDATE="true"
ENV DISABLE_AUTOUPDATE="true"
ENV DISABLE_VIRTUAL_DESKTOP="false"
ENV DISPLAY_WIDTH="900"
ENV DISPLAY_HEIGHT="700"
ENV WINETRICKS_ACCEPT_EULA=1
ENV DEBIAN_FRONTEND=noninteractive
ENV WINEDEBUG=-all
ENV DISPLAY=:0

# Install dependencies and Wine
# Note: Using Wine64 only (no i386 architecture needed)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        gnupg2 \
        winbind \
        xvfb \
        7zip \
        cabextract \
        locales \
        wget

# Install Wine from Ubuntu's default repositories instead of WineHQ
# WineHQ may not have packages for Ubuntu 24.04 yet
    
    # Install Wine and Winetricks
RUN apt-get update && \
    apt-get install -y --install-recommends wine wine64 winetricks && \
    # Configure locale
    sed -i -e 's/# en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen && \
    dpkg-reconfigure --frontend=noninteractive locales && \
    update-locale LANG=en_US.UTF-8 && \
    # Clean up APT cache
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

EXPOSE 5900

# Copy startup script and other files. The startapp.sh script will handle
# the Backblaze installation and execution at runtime.
COPY rootfs/ /

RUN chmod +x /startapp.sh
