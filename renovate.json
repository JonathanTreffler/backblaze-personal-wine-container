{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Open PRs for everything, but never auto-merge by default.",
      "matchPackageNames": [
        "*"
      ],
      "automerge": false
    },
    {
      "description": "Only auto-merge jlesage/baseimage-gui digest bumps.",
      "matchPackageNames": [
        "jlesage/baseimage-gui"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "automerge": true
    }
  ]
}
